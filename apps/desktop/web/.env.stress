# Zinuto frontend stress profile
# Use with Vite mode:
# npm run dev --workspace=@zinuto/desktop-web -- --mode stress
# npm run build --workspace=@zinuto/desktop-web -- --mode stress

VITE_HISTORY_BARS_MAX=150000
VITE_HISTORY_PROJECT_PAGE_SIZE=200
VITE_REPLAY_NOTE_PAGE_SIZE=200
VITE_MAX_ARCHIVE_REPLAY_BARS=150000
VITE_MAX_ARCHIVE_REPLAY_FILLS=250000
VITE_MAX_ARCHIVE_DRAWING_COUNT=50000
VITE_MAX_ARCHIVE_TEXT_CHARS=2000

